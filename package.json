{
  "name": "saldo-desktop",
  "version": "4.6.1",
  "private": true,
  "description": "Gestão local de cartões, compras parceladas e planejamento financeiro.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "node tests/ui.mjs",
    "test:layout": "node tests/layout.mjs",
    "test:desktop": "node tests/desktop.mjs",
    "test:updater": "node tests/updater-windows.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "lucide-react": "1.56.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.2",
    "playwright": "1.64.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
