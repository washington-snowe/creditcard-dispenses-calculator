# Copy to .env.local. Firebase web identifiers are public, never use admin keys here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=southamerica-east1

# Keep disabled until provider, prices, server and webhook are implemented and tested.
VITE_CHECKOUT_ENABLED=false

# Required before opening registration / commercial launch.
VITE_SUPPORT_EMAIL=
VITE_SELLER_NAME=
VITE_SELLER_DOCUMENT=
