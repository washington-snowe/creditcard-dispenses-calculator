rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Billing is written exclusively by a trusted backend using Admin SDK.
    // Clients can read only their own document; they cannot grant themselves access.
    match /billing/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
